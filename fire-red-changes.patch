+        break;
+    case 1: // NO
+    case MENU_B_PRESSED:
+        ClearDialogWindowAndFrame(WIN_INTRO_TEXTBOX, TRUE);
+        gTasks[taskId].func = Task_OakSpeech_ShowDifficultyOptions;
+        break;
+    }
+}
