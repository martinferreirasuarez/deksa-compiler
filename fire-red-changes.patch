+
+    ClearStdWindowAndFrameToTransparent(tMenuWindowId, TRUE);
+    RemoveWindow(tMenuWindowId);
+    ClearStdWindowAndFrameToTransparent(tDifficultyHelpWindowId, TRUE);
+    RemoveWindow(tDifficultyHelpWindowId);
+}
+
+static void Task_OakSpeech_ShowDifficultyOptions(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+    u8 i;
+
+    if (IsTextPrinterActive(WIN_INTRO_TEXTBOX))
+        return;
+
+    ClearDialogWindowAndFrame(WIN_INTRO_TEXTBOX, TRUE);
+    tMenuWindowId = AddWindow(&sIntro_WindowTemplates[WIN_INTRO_DIFFICULTY_LIST]);
+    tDifficultyHelpWindowId = AddWindow(&sIntro_WindowTemplates[WIN_INTRO_DIFFICULTY_HELP]);
+    PutWindowTilemap(tMenuWindowId);
+    PutWindowTilemap(tDifficultyHelpWindowId);
+    DrawStdFrameWithCustomTileAndPalette(tMenuWindowId, TRUE, GetStdWindowBaseTileNum(), 14);
+    DrawStdFrameWithCustomTileAndPalette(tDifficultyHelpWindowId, TRUE, GetStdWindowBaseTileNum(), 14);
+    FillWindowPixelBuffer(tMenuWindowId, PIXEL_FILL(1));
+    for (i = 0; i < DEKSA_DIFFICULTY_COUNT; i++)
+        AddTextPrinterParameterized3(tMenuWindowId, FONT_NORMAL, 10, 2 + 16 * i, sTextColor_DarkGray, 0, sDifficultyNames[i]);
+    Menu_InitCursor(tMenuWindowId, FONT_NORMAL, 0, 2, 16, DEKSA_DIFFICULTY_COUNT, tDifficulty);
+    PrintDifficultyHelp(tDifficultyHelpWindowId, tDifficulty);
+    CopyWindowToVram(tMenuWindowId, COPYWIN_FULL);
+    CopyWindowToVram(tDifficultyHelpWindowId, COPYWIN_FULL);
+    gTasks[taskId].func = Task_OakSpeech_HandleDifficultyInput;
+}
+
+static void Task_OakSpeech_HandleDifficultyInput(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+    u8 previousDifficulty = tDifficulty;
+    s8 input = Menu_ProcessInputNoWrapAround();
+
+    tDifficulty = Menu_GetCursorPos();
+    if (tDifficulty != previousDifficulty)
+        PrintDifficultyHelp(tDifficultyHelpWindowId, tDifficulty);
+
+    if (input >= 0)
+    {
+        ClearDifficultyWindows(taskId);
+        OakSpeechPrintMessage(sDifficultyConfirmText[tDifficulty], sOakSpeechResources->textSpeed);
+        gTasks[taskId].func = Task_OakSpeech_ConfirmDifficulty;
+    }
+}
+
